@@ -1,12 +1,15 @@
 // Observation of FFT 1.5.1's pillarbox (final fantasy tactics - the ivalice chronicles, main ace351a145c07a51f8e239666640a0d8). The profile's registered cuts kill the
 // wide-viewport clamp (main+0x8ed18 / +0x8ed24), yet the picture still reaches the screen confined to a centered 16:9 (a 1578.67x888 content rect in 1920x888, measured on the
 // device), so another place confines it. The device sessions with the first four (2026-11-21, a battle included) left every one of them cleared: the fitter's compare/select never
-// ran (PB_RECT 0, its 1329/2320 calls all pass small UI rects), the wide-viewport branch after the cuts never entered (VP_CLAMP 0: no render target arrives wider than 16:9), and the
-// camera's aspect is 2.162 (CAM). Six observation gates now record what the candidates see, one tab-separated line per
-// hit in Documents/pillarbox_probe.txt: the letterbox fitter's caller (its arguments and the input rect), the fitter's compare/select block (its target and output floats), the
-// wide-viewport branch after the cuts (the target triple and the clamped floats), the camera aspect store (the aspect and the first-layer pointer chain), the bake's settings-pair
-// load (the width/height pair the item's create sees) and the layer-composition rect push (the rect a layer is made across). Read-only: a
-// callback changes no register, so the game runs as without them. Diagnostic for the fork's wide-aspect work; the size cap on the file keeps a long session bounded
+// ran ("PB_RECT 0"), the letterbox fitter's caller (PB_CALL) was fed almost only small UI rects. The 2026-11-21 revE battle session cleared the next two: the bake's settings pair is the
+// full [1920 888] (TBK_PAIR 1 hit) and the layer-composition rect push carries the full 1920x888 (ELY_RECT 1 hit), while PB_CALL's input rects included (32, 0, 1664, 888) = a 1632x888
+// rect 256 times - 888*16/9 = 1578.67 is exactly the confined width measured on the device, and the fitter body (main+0x45f7d0) holds the 16:9 clamp in plain sight at +0x45f914 (fdiv
+// s3 = W/1.7778, fmul s2 = H*1.7778, two fcsel pick the clamped pair, s5 = the left half-bar) - but that block only runs on the null-rect variant; the rect-carrying variant seen at
+// runtime runs the integer half-diff centering at +0x45f898..+0x45f910. Ten observation gates now
+// record what happens, one tab-separated line per hit in Documents/pillarbox_probe.txt: the caller and its input rect, the compare/select block, the wide-viewport branch after the
+// cuts, the camera aspect store, the bake's settings-pair load, the layer-composition rect push, and now the fitter's three Output writes (rect path A and B, and the null-rect float
+// clamp C) plus the caller's consumption of the 16 bytes at [x21+0xd0] right after the call. Read-only: a callback changes no register, so the game runs as
+// without them. Diagnostic for the fork's wide-aspect work; the size cap on the file keeps a long session bounded
 #include "dm.h"
 #include <errno.h>
 #include <mach/mach.h>
@@ -111,8 +114,41 @@ static void pb_ely_rect(uint64_t *r, int param) {
     pb_line("ELY_RECT", "w1 %u\tw2 %u\tw3 %u\tw4 %u", (uint32_t)r[1], (uint32_t)r[2], (uint32_t)r[3], (uint32_t)r[4]);
 }
 
+// The fitter's rect-path output writes. Path A (a real rect was passed, x26): +0x45f8c8/+0x45f8cc write [x0] = (l,t) and [x0,#8] = (r,b) as the input rect translated by the half-diff
+// offsets. Path B (a second rect, x25): +0x45f90c (+ its tail at +0x45f9cc) writes [x0,#0x10] = (l',t') and [x0,#0x18] = (r',b'). Either row that lands as (170..171, 0, 1749, 888)
+// (or the same shifted by x) names the fitter's output as the confined rect itself
+static void pb_fit_out_a(uint64_t *r, int param) {
+    (void)param;
+    pb_line("FIT_A", "x0 %llx\tout %u %u %u %u", PB_LL(r[0]), (uint32_t)r[20], (uint32_t)r[24], (uint32_t)r[26], (uint32_t)r[27]);
+}
+
+static void pb_fit_out_b(uint64_t *r, int param) {
+    (void)param;
+    pb_line("FIT_B", "x0 %llx\tout %u %u %u %u", PB_LL(r[0]), (uint32_t)r[12], (uint32_t)r[13], (uint32_t)r[8], (uint32_t)r[9]);
+}
+
+// The null-rect float clamp's output: +0x45f968/+0x45f96c write [x0] = (offset x,y) and [x0,#8] = (x+w, y+h) of the 16:9-clamped, centered rect (for a (1632,888) input: 170, 0, 1749, 888)
+static void pb_fit_out_c(uint64_t *r, int param) {
+    (void)param;
+    pb_line("FIT_C", "x0 %llx\tout %u %u %u %u\ts0 %.3f\ts1 %.3f\ts2 %.3f\ts3 %.3f\ts5 %.3f",
+            PB_LL(r[0]), (uint32_t)r[20], (uint32_t)r[24], (uint32_t)r[26], (uint32_t)r[27],
+            pb_f32(PB_S(r, 0)), pb_f32(PB_S(r, 1)), pb_f32(PB_S(r, 2)), pb_f32(PB_S(r, 3)), pb_f32(PB_S(r, 5)));
+}
+
+// The caller's consumption right after the fitter call: main+0x46f2f0, ldp s0,s1,[x21,#0xd0] (then s2,s3 from +0xd8). The 16 bytes at [x21+0xd0] are what the caller takes as the
+// fitter's result and feeds the layer/viewport math - the pair seen here is the pair that confines the picture if the fitter is the confiner
+static void pb_fit_src(uint64_t *r, int param) {
+    (void)param;
+    uint32_t v[4] = {0, 0, 0, 0};
+    pb_mem((const void *)(uintptr_t)(r[21] + 0xd0), sizeof v, v);
+    pb_line("FIT_S", "x21 %llx\t[%.3f %.3f %.3f %.3f]", PB_LL(r[21]),
+            pb_f32(v[0]), pb_f32(v[1]), pb_f32(v[2]), pb_f32(v[3]));
+}
+
 __attribute__((constructor)) static void pillarbox_attach(void) {
     gate_obs_set(OBS_PILLARBOX_CALL, pb_call); gate_obs_set(OBS_PILLARBOX_RECT, pb_rect);
     gate_obs_set(OBS_VIEWPORT_CLAMP, pb_clamp); gate_obs_set(OBS_CAMERA_ASPECT, pb_camera);
     gate_obs_set(OBS_TBK_PAIR, pb_tbk_pair); gate_obs_set(OBS_ELY_RECT, pb_ely_rect);
+    gate_obs_set(OBS_FITTER_OUT_A, pb_fit_out_a); gate_obs_set(OBS_FITTER_OUT_B, pb_fit_out_b);
+    gate_obs_set(OBS_FITTER_OUT_C, pb_fit_out_c); gate_obs_set(OBS_FITTER_SRC, pb_fit_src);
 }
