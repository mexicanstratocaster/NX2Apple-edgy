From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mexicanstratocaster <mexicanstratocaster@users.noreply.github.com>
Date: Fri, 20 Nov 2026 02:07:55 -0700
Subject: [PATCH] FFT: persist the v524288 shader tables
 (package/shader_versions v524288)

Upstream-Status: fork-only
Reason: the profile's committed shader tables were split on update v393216; packing the folder's newest version (v524288) fails the strict split-vs-profile comparison (18 rows' GLSLC code offsets shifted). These are the tables regenerated from the v524288 split, persisted in the fork so a build does not depend on untracked machine-local tables.
Issue: LNPANDY/NX2Apple (none filed)

---
 dm/games/010038B015560000/game.tsv         |   4 +-
 dm/games/010038B015560000/pso_pairs.tsv    |   1 +
 dm/games/010038B015560000/shader_facts.tsv |   2 +-
 dm/games/010038B015560000/shader_map.tsv   | 100 ++++++++++-----------
 4 files changed, 54 insertions(+), 53 deletions(-)
 create mode 100644 dm/games/010038B015560000/pso_pairs.tsv

diff --git a/dm/games/010038B015560000/game.tsv b/dm/games/010038B015560000/game.tsv
index 29e9600..2c71868 100644
--- a/dm/games/010038B015560000/game.tsv
+++ b/dm/games/010038B015560000/game.tsv
@@ -18,8 +18,8 @@ pad_layout	full
 build	v393216	1.4.0	main=3cfd457814dd647f4cd0f0ae9f9454d2	sdk=d83a56a5558798414c78ec722867a7da
 # 1.5.1's sdk build ID is read from the update dump's own NSO (2026-11-20, dm/tools/nso.py) and matches 1.4.0's, so the two share the SDK row and its patches
 build	v524288	1.5.1	main=ace351a145c07a51f8e239666640a0d8	sdk=d83a56a5558798414c78ec722867a7da
-package	v393216
-shader_versions	v393216
+package	v524288
+shader_versions	v524288
 
 # ---- Files ----
 # load order as on Horizon: main, sdk; not loaded, main takes nothing from it the host does not supply: subsdk0 (NintendoSDK_OpenGL)
diff --git a/dm/games/010038B015560000/pso_pairs.tsv b/dm/games/010038B015560000/pso_pairs.tsv
new file mode 100644
index 0000000..ccd0445
--- /dev/null
+++ b/dm/games/010038B015560000/pso_pairs.tsv
@@ -0,0 +1 @@
+# kind: evidence  supplemental vertex / pixel shader pairs (BAHS program variations and legacy Unity pass-input covers) for vertex output padding and the pipeline prebuild (generated by dm/gfx/tools/shader_split.py, do not edit): vertex key <TAB> pixel key
diff --git a/dm/games/010038B015560000/shader_facts.tsv b/dm/games/010038B015560000/shader_facts.tsv
index 45b4da2..083c47b 100644
--- a/dm/games/010038B015560000/shader_facts.tsv
+++ b/dm/games/010038B015560000/shader_facts.tsv
@@ -1,4 +1,4 @@
-# Answer table for translation queries (generated by dm/gfx/tools/shader_split.py, do not edit): key <TAB> fact JSON. This game has no PC version to pair with: only the thread group / shared memory of compute shaders (taken from the control section); other queries get the translator defaults
+# Answer table for translation queries (generated by dm/gfx/tools/shader_split.py, do not edit): key <TAB> fact JSON. No PC shader pairing supplied: only the thread group / shared memory of compute shaders (taken from the control section); other queries get the translator defaults
