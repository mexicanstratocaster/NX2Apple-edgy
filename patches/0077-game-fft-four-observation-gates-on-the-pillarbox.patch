+# VP_CLAMP / CAM tags), truncated at 60 MB. The original word is the value here at the rewrite: 0x8ed18's is the nop the cut above writes (a gate may sit on a cut's site, the
+# allocator constructor's does), the others' are 1.5.1's own instructions
+OBS = {
+  'ace351a145c07a51f8e239666640a0d8': [
+    (0x46f2b0, 27, 'f9400102', "pillarbox: the letterbox fitter main+0x45f7d0's one non-null-rect call (bl main+0x46f2b4): x0-x5 and the 16 bytes at [x5], the input rect"),
+    (0x45f988, 28, '1e230101', "pillarbox: the fitter's compare/select block, s0-s5 (the content pair converted and the clamped output pair with its offsets) and the integer pair w8/w11"),
+    (0x8ed18, 29, 'd503201f', "pillarbox: the wide-viewport branch after the cuts above, w23/w24/w25 (the target triple) and s0-s3 (the converted pair, the clamp constant, the product)"),
+    (0xdc5dc, 30, 'd29ae149', 'pillarbox: before the camera aspect store (str s0,[x20,#0xcd8] at +8): the camera x20, the aspect stored before, and the first-layer chain [x19+0x4d00]+0x30'),
