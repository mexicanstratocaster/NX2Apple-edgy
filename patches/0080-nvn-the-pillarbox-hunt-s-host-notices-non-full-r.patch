From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tanori-rider <rtanori1@asu.edu>
Date: Fri, 20 Nov 2026 18:48:11 -0700
Subject: [PATCH]  nvn: the pillarbox hunt's host notices - non-full RT binds,
 full-height side-cut viewports and scissors; DM_NVN_LOG read lazily

DM_NVN_LOG was read only in the constructor (nvn_init_slots runs from
nvn_nops_register), which is before env.txt is applied, so the texture census
could never turn on from the device env. Read it lazily instead (nvn_log_on).

With the guest gates exhausted (bake pair, layer push both full-wide; the
letterbox fitter UI-only; the wide-viewport RT builder never runs), observe from
the host where no guest patch is needed: every distinct render-target bind whose
sizes are not the display pair, and every full-height viewport / scissor that is
x-offset or side-cut - a 1578x888 scene target or a 170-wide scissor pair names
the confiner in one battle.

Generated by Mistral Vibe.
Co-Authored-By: Mistral Vibe <vibe@mistral.ai>

Upstream-Status: fork-only
Reason: The pillarbox hunt, revG (host side, dm/gfx/nvn/hle_nvn.c): the guest observation gates are exhausted (the bake pair and the layer-composition push carry the full 1920x888, the letterbox fitter is the UI RectTransform fitter with its float 16:9 clamp provably never on a live path, and the wide-viewport RT builder main+0x8ecac never runs at all), so observe from the host where no guest patch is needed: every distinct render-target bind that is not the display pair, every full-height viewport / scissor that is x-offset or side-cut, and DM_NVN_LOG read lazily so the texture census finally turns on from the device env (it was read in a constructor, before env.txt is applied)
Issue: mexicanstratocaster/NX2Apple-edgy#1

---
 dm/gfx/nvn/hle_nvn.c | 49 +++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 46 insertions(+), 3 deletions(-)

diff --git a/dm/gfx/nvn/hle_nvn.c b/dm/gfx/nvn/hle_nvn.c
index 0e02cf6..4f4ea57 100644
--- a/dm/gfx/nvn/hle_nvn.c
+++ b/dm/gfx/nvn/hle_nvn.c
@@ -84,17 +84,20 @@ typedef struct { const char *name; void *fn; } nvn_impl;
     DM_REGISTER("swnvn", nvn_impl, e_##name, {#name, (void *)h_##name}); \
     static ret h_##name(__VA_ARGS__)
 
-static int g_log;
+static int nvn_log_on(void) {   // DM_NVN_LOG, read lazily: env.txt is applied after the constructors run (the boot line lands after nvn_init_slots happened), so a snapshot taken
+    static int on = -1;          // there would be 0 for the whole process; re-reading a none-set name costs one getenv per caller site until the variable exists
+    if (on < 0) on = getenv("DM_NVN_LOG") != NULL;
+    return on;
+}
 static pthread_mutex_t g_sub_mu = PTHREAD_MUTEX_INITIALIZER;
 static _Atomic uint64_t g_serial;
 uint64_t nvn_new_serial(void) { return ++g_serial; }
 void nvn_serial_floor(uint64_t s) { uint64_t c = atomic_load(&g_serial); while (c < s && !atomic_compare_exchange_weak(&g_serial, &c, s)) {} }
 static unsigned g_nsem;                          // Number of semantic implementations (filled by nvn_init_slots)
-#define OLOG(...) do { if (g_log) LOG("[nvn] " __VA_ARGS__); } while (0)
+#define OLOG(...) do { if (nvn_log_on()) LOG("[nvn] " __VA_ARGS__); } while (0)
 
 static void nvn_init_slots(void) {
     static int done; if (done) return; done = 1;
-    g_log = getenv("DM_NVN_LOG") != NULL;
     unsigned long sz;
     const nvn_impl *im = (const nvn_impl *)getsectiondata(DM_HOST_IMAGE, "__DATA", "swnvn", &sz);
     unsigned nim = im ? (unsigned)(sz / sizeof *im) : 0, hit = 0;
@@ -1460,6 +1463,43 @@ static const tex_t *tex_snap(void *rec_, size_t off, int k, const NVNtexture *t,
     }
     return s;
 }
+// The pillarbox hunt (revF): the picture reaches the screen confined to a centered 16:9 (1578.67x888 content in the 1920x888 swap chain) while the game's own wide-viewport RT builder
+// (main+0x8ecac) provably never runs (VP_CLAMP 0 in three device sessions) and the letterbox fitter is UI-only. These host notices catch the remaining suspects from outside: every
+// distinct render-target bind that is not the full display pair (a 1578x888 scene target would name the confinement directly), and every viewport / scissor that is a full-height
+// centered side-cut (170-172 wide bars or a 1578-1580 width at x 169-171). Bounded: one line per new shape until the budget runs out
+static void pb_rt_note(int n, const NVNtexture *const *ct, const NVNtexture *dt) {
+    if (!nvn_log_on()) return;
+    static _Atomic int budget = 220;
+    if (atomic_fetch_sub(&budget, 1) <= 0) return;
+    const tex_t *f = ct && n > 0 && ct[0] ? CTX(ct[0]) : NULL, *d = dt ? CTX(dt) : NULL;
+    int w = f ? f->d.width : 0, h = f ? f->d.height : 0, dw = d ? d->d.width : 0, dh = d ? d->d.height : 0;
+    if ((!f || (w == 1920 && h == 888)) && (!d || (dw == 1920 && dh == 888))) { atomic_fetch_add(&budget, 1); return; }
+    static int lw = -1, lh = -1, ldw = -1, ldh = -1;
+    if (w == lw && h == lh && dw == ldw && dh == ldh) { atomic_fetch_add(&budget, 1); return; }
+    lw = w; lh = h; ldw = dw; ldh = dh;
+    LOG("[nvn] pillarbox RT bind: color %dx%d fmt %#x, depth %dx%d fmt %#x", w, h, f ? f->d.format : 0, dw, dh, d ? d->d.format : 0);
+}
+
+static void pb_vp_note(float x, float y, float w, float h) {
+    if (!nvn_log_on()) return;
+    if (!(w >= 800.0f && 860.0f <= h && h <= 920.0f && (x > 4.0f || w < 1900.0f))) return;
+    static _Atomic int n_; if (atomic_fetch_add(&n_, 1) > 48) return;
+    static float lx = -1, ly = -1, lw = -1, lh = -1;
+    if (x == lx && y == ly && w == lw && h == lh) return;
+    lx = x; ly = y; lw = w; lh = h;
+    LOG("[nvn] pillarbox viewport: x %.1f y %.1f w %.1f h %.1f", x, y, w, h);
+}
+
+static void pb_sc_note(int x, int y, int w, int h) {
+    if (!nvn_log_on()) return;
+    if (!(w >= 800 && h >= 860 && h <= 920 && (x > 4 || w < 1900))) return;
+    static _Atomic int n_; if (atomic_fetch_add(&n_, 1) > 48) return;
+    static int lx = -1, ly = -1, lw = -1, lh = -1;
+    if (x == lx && y == ly && w == lw && h == lh) return;
+    lx = x; ly = y; lw = w; lh = h;
+    LOG("[nvn] pillarbox scissor: x %d y %d w %d h %d", x, y, w, h);
+}
+
 NVN(nvnCommandBufferSetRenderTargets, void, NVNcommandBuffer *c, int n, const NVNtexture *const *ct, const NVNtextureView *const *cv,
     const NVNtexture *dt, const NVNtextureView *dv) {
     if (n < 0 || n > 8) { LOG("[RED] SetRenderTargets count %d", n); n = n < 0 ? 0 : 8; }
@@ -1468,6 +1508,7 @@ NVN(nvnCommandBufferSetRenderTargets, void, NVNcommandBuffer *c, int n, const NV
     r->depth = tex_snap(r, SNAP_OFF(p_set_rt), n, dt, (uint64_t)__builtin_return_address(0)); copy_view(&r->dview, &r->has_dview, dv);
     for (int i = 0; i < n; i++) if (r->color[i]) mtl_tex_gpu_written(r->color[i]);
     if (r->depth) mtl_tex_gpu_written(r->depth);
+    pb_rt_note(n, ct, dt);
 }
 NVN(nvnCommandBufferClearColor, void, NVNcommandBuffer *c, int index, const float *rgba, int mask) {
     p_clear_color *r = REC(c, OP_CLEAR_COLOR, p_clear_color); r->index = index; r->mask = mask; memcpy(r->rgba, rgba, 16);
@@ -1494,12 +1535,14 @@ static int slots_bound(const char *what, int st, int first, int n, int slots) {
 }
 NVN(nvnCommandBufferSetViewports, void, NVNcommandBuffer *c, int first, int n, const float *v) {
     if (slots_fit(0, first, n, 16) != n) { LOG("[RED] SetViewports first=%d n=%d", first, n); return; }
+    pb_vp_note(v[0], v[1], v[2], v[3]);
     if (g_rec_compact && first >= 0) { uint8_t *q = crec(c, OPC_VIEWPORTS, (uint32_t)first | (uint32_t)n << 8 | (uint32_t)(((dev_t_ *)CB(c)->dev)->origin + 1) << 16, 16 * (size_t)n); memcpy(q, v, 16 * (size_t)n); return; }
     p_viewports *r = REC(c, OP_VIEWPORTS, p_viewports); r->first = first; r->n = n;
     for (int i = 0; i < n; i++) memcpy(r->v[i], v + 4 * i, 16);
     r->origin = ((dev_t_ *)CB(c)->dev)->origin + 1;
 }
 NVN(nvnCommandBufferSetScissor, void, NVNcommandBuffer *c, int x, int y, int w, int h) {
+    pb_sc_note(x, y, w, h);
     if (g_rec_compact && (unsigned)x < 0x10000 && (unsigned)y < 0x10000 && (unsigned)w < 0x10000 && (unsigned)h < 0x10000) {
         uint16_t v[4] = {(uint16_t)x, (uint16_t)y, (uint16_t)w, (uint16_t)h}; memcpy(crec(c, OPC_SCISSOR, 0, 8), v, 8); return;
     }
