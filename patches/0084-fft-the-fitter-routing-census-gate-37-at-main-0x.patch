+// The fitter routing point: main+0x46f250, the cbz w8 on the layer's routing flag [x21+0x1ec] (flag != 0 falls through to the fitter call at main+0x46f2b4, flag == 0 branches to the
+// alternate path at main+0x46f2bc). The gate sits on the cbz itself, so both paths pass through it and the cbz re-executes after the callback. Logged: the flag as the cbz tests it
+// (w8), the flag field read back from the layer, the layer object (x21) and its first word (the vtable, to tag object classes across rows), the stack rect (x,y,x2,y2) the call is
+// about to pass (16 bytes at [x29-0x20], built at main+0x46f244/0x46f24c), and the layer rect floats s0/s2 (x and w before the integer conversion). This answers, in one run,
+// which object classes and flag values reach the fitter: whether a consumer-side cut can be guarded to the battle layer, and whether the small UI rects share the same vtable class
+static void pb_routing(uint64_t *r, int param) {
+    (void)param;
+    uint32_t rect[4] = {0, 0, 0, 0}; uint8_t field = 0; uint64_t vt = 0;
+    if (r[29]) pb_mem((const void *)(uintptr_t)(r[29] - 0x20), sizeof rect, rect);
+    pb_mem((const void *)(uintptr_t)(r[21] + 0x1ec), sizeof field, &field);
+    pb_mem((const void *)(uintptr_t)r[21], sizeof vt, &vt);
+    pb_line("FIT_ROUTE", "x21 %llx\tvt %llx\tflag %llu\tfield %u\trect %u %u %u %u\ts0 %.3f\ts2 %.3f",
+            PB_LL(r[21]), PB_LL(vt), PB_LL(r[8]), (unsigned)field,
+            rect[0], rect[1], rect[2], rect[3], pb_f32(PB_S(r, 0)), pb_f32(PB_S(r, 2)));
+}
