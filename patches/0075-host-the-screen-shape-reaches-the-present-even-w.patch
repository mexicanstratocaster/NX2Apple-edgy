From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vibe Nuage Agent <vibe@mistral.ai>
Date: Fri, 20 Nov 2026 17:30:34 +0000
Subject: [PATCH] host: the screen shape reaches the present even without a
 frame-step state page (FFT 1.5.1)

Upstream-Status: fork-only
Reason: the screen shape (DM_SCREEN_ASPECT) reached the present only through dm_fps_state_apply's state-page path, which returns at once for a build with no frame-step state page (FFT 1.5.1: stubs 0, but the widescreen cuts render 1920x888 on their own): mtl_present_screen never ran, the present fell back to 16:9 and pillarboxed the wide frames (the 2026-11-20 device sessions: picture shape 1920x1080 with DM_SCREEN_ASPECT=2.173 set). The parsing now runs for state-page-less builds too, and mtl_present_screen is called in both paths
Issue: mexicanstratocaster/NX2Apple-edgy#1

---
 dm/host/loader.c | 88 +++++++++++++++++++++++++-----------------------
 1 file changed, 46 insertions(+), 42 deletions(-)

diff --git a/dm/host/loader.c b/dm/host/loader.c
index b494e321..77bb9fbc 100644
--- a/dm/host/loader.c
+++ b/dm/host/loader.c
@@ -335,8 +335,52 @@ static void install_fps_state(module_t *m) {
 }
 // The settings in the state page, written when the game starts (main.c, after host loading): on iOS the loading runs at app launch, before the launcher has set DM_FPS_TARGET and
 // DM_RENDER_SCALE (Launcher.swift), and nothing reads the page before the game runs
+// The screen shape: DM_SCREEN_ASPECT, the screen's width / height between 1.3 and 2.4, makes the builds with screen-shape stubs
+// (Breath of the Wild 1.9.0's patches.py) render that shape. Taller than 16:9 (an iPad's 1.33, an unfolded iPhone Duo's 1.43): the output keeps its width (1920) and
+// takes the height that gives the ratio, a multiple of 48 so the 2/3-size layout space (1280 wide) stays whole: 1.43 → 1920x1344 and 1280x896. Wider than 16:9 (a lying
+// phone's 19.5:9 ≈ 2.17): the height is 1920 / ratio rounded to a multiple of 8 instead (2.17 → 1920x880), since the 48 grid leaves the picture 2.2 % off a 2.17 screen and
+// the present would crop. The layout height stays 2/3 of the output height, rounded. State +0x48 u32 output height, +0x4c u32 layout height, +0x50 its float; 0 = 16:9.
+// A build without a state page runs it too (FFT 1.5.1: stubs 0, but its widescreen cuts render 1920x888 on their own): the present must learn the picture's shape
+// (mtl_present_screen, nvn_mtl.m present_shape) or it falls back to 16:9 and pillarboxes the wide frames (the 2026-11-20 device sessions)
+static void apply_screen_shape(void) {
+    const char *as = getenv("DM_SCREEN_ASPECT");
+    if (!as || !*as || !strcmp(as, "0") || !strcmp(as, "auto")) return;   // 0: 16:9; auto: the iOS front end resolves it to the screen's shape (a Mac window has none)
+    char *end; float a = strtof(as, &end);
+    if (end == as || *end || !(a >= 1.3f && a < 2.4f)) { LOG("[RED] DM_SCREEN_ASPECT=%s: a width / height from 1.3 to 2.4; keeping 16:9", as); return; }
+    int is_wide = a > 16.0f / 9.0f;
+    uint32_t oh = is_wide ? (uint32_t)(1920.0f / a / 8.0f + 0.5f) * 8 : (uint32_t)(1920.0f / a / 48.0f + 0.5f) * 48;
+    uint32_t lh = is_wide ? (uint32_t)((oh * 2 + 2) / 3) : oh * 2 / 3; float lf = (float)lh;
+    if (dm_fps_state) { memcpy(dm_fps_state + 0x48, &oh, 4); memcpy(dm_fps_state + 0x4c, &lh, 4); memcpy(dm_fps_state + 0x50, &lf, 4); }
+    extern void mtl_present_screen(uint32_t w, uint32_t h); mtl_present_screen(1920, oh);   // the picture's shape for a texture that follows it (nvn_mtl.m present_shape)
+    const char *ms = getenv("DM_SCREEN_ASPECT_SITES"); uint32_t mask = ms ? (uint32_t)strtoul(ms, NULL, 0) : 0xffffffffu;   // the stubs of the game's own conversions, one bit each (+0x54)
+    if (dm_fps_state) memcpy(dm_fps_state + 0x54, &mask, 4);
+    if (ms) LOG("%s: screen shape: conversion sites %#x (DM_SCREEN_ASPECT_SITES)", g_fps_mod ? g_fps_mod : "host", mask);
+    // The field of view: views of the screen's ratio (the scene, the HUD's camera) keep 16:9's sides and show more above and below; on a wider screen they keep the
+    // 16:9 vertical angle instead of narrowing (k = (16/9) / r, floored at 1: more at the sides, the same height in view) (patches.py's sead::PerspectiveProjection stubs)
+    float r = 1920.0f / (float)oh, k = (16.0f / 9.0f) / r, tol = 0.01f; if (k < 1.0f) k = 1.0f;
+    const char *fo = getenv("DM_SCREEN_FOV"); if (fo && !strcmp(fo, "off")) tol = -1.0f;   // trials: the scene keeps the game's vertical angle (no view matches); the HUD camera still widens
+    // The HUD at the taller edges (patches.py duo_anchor.c, +0x80..+0x98): the shift (half the layout height over 360), the stretch of full-screen panes, the edge rule's
+    // distance, the listed corner widgets' distance, a full-screen pane's width and height in the 1280x720 space, and the tallest one still stretched (a menu's
+    // background is about 720 tall, the weapon wheel's gradient 1280; the map's tiles are left alone anyway)
+    // (Mac, a Master Mode save: an edge distance of 280 takes the menus' title bars (286 to 320), the map's frame pieces (284 to 360) and the bottom guides (-318) along
+    // as whole rows; 330 left the title bars and the rupee count in the middle while the hearts moved. Text moves with its widget since the rule runs where global
+    // matrices are computed. Only panes as wide and as tall as the screen are stretched: a width of 0 stretched the inventory's half-width side panel past its top
+    // and bottom bars). DM_SCREEN_HUD=<edge>,<listed>,<full-screen width>,<full-screen height>[,<tallest>]
+    // overrides them for trials
+    float anc[7] = {(float)lh / 2 - 360.0f, (float)lh / 720.0f, 280.0f, 100.0f, 1270.0f, 710.0f, 1300.0f};
+    const char *hv = getenv("DM_SCREEN_HUD");
+    if (hv && sscanf(hv, "%f,%f,%f,%f,%f", &anc[2], &anc[3], &anc[4], &anc[5], &anc[6]) < 4) LOG("[RED] DM_SCREEN_HUD=%s: <edge>,<listed>,<full width>,<full height>[,<tallest>]; keeping the rest", hv);
+    if (dm_fps_state) {
+        memcpy(dm_fps_state + 0x58, &r, 4); memcpy(dm_fps_state + 0x5c, &k, 4); memcpy(dm_fps_state + 0x60, &tol, 4);
+        float wide = 16.0f / 9.0f, wtol = 0.001f, far = 10000.0f;   // the HUD camera's projection: 16:9, near 1, far 10000 (+0x74 / +0x78 / +0x7c)
+        memcpy(dm_fps_state + 0x74, &wide, 4); memcpy(dm_fps_state + 0x78, &wtol, 4); memcpy(dm_fps_state + 0x7c, &far, 4);
+        memcpy(dm_fps_state + 0x80, anc, sizeof anc);
+    }
+    LOG("%s: screen shape: HUD moves out by %.0f (edge %.0f, listed widgets %.0f), panes %.0fx%.0f or larger stretched %.3f", g_fps_mod ? g_fps_mod : "host", anc[0], anc[2], anc[3], anc[4], anc[5], anc[1]);
+    LOG("%s: screen shape %.3f%s: output 1920x%u, layout 1280x%u (DM_SCREEN_ASPECT; only builds with screen-shape stubs follow it)", g_fps_mod ? g_fps_mod : "host", a, is_wide ? " wide" : "", oh, lh);
+}
 void dm_fps_state_apply(void) {
-    if (!dm_fps_state) return;
+    if (!dm_fps_state) { apply_screen_shape(); return; }   // no frame-step state page: the screen shape still decides the present's picture shape
     const char *e = getenv("DM_FPS_TARGET"); int t = e ? atoi(e) : dm_profile()->fps_target;
     if (t != 0 && t != 30 && t != 60) { LOG("[RED] DM_FPS_TARGET=%s: must be 0, 30 or 60; using the game's own frame step", e); t = 0; }
     float f = (float)t; memcpy(dm_fps_state, &f, sizeof f);
@@ -351,47 +395,7 @@ void dm_fps_state_apply(void) {
     const char *dr = getenv("DM_DYNAMIC_RESOLUTION"); uint32_t dyn = dr && !strcmp(dr, "1");
     if (dr && strcmp(dr, "0") && strcmp(dr, "1")) LOG("[RED] DM_DYNAMIC_RESOLUTION=%s: must be 0 or 1; keeping full resolution", dr);
     memcpy(dm_fps_state + 0x40, &dyn, sizeof dyn);
-    // Screen shape: DM_SCREEN_ASPECT, the screen's width / height between 1.3 and 2.4, makes the builds with screen-shape stubs
-    // (Breath of the Wild 1.9.0's patches.py) render that shape. Taller than 16:9 (an iPad's 1.33, an unfolded iPhone Duo's 1.43): the output keeps its width (1920) and
-    // takes the height that gives the ratio, a multiple of 48 so the 2/3-size layout space (1280 wide) stays whole: 1.43 → 1920x1344 and 1280x896. Wider than 16:9 (a lying
-    // phone's 19.5:9 ≈ 2.17): the height is 1920 / ratio rounded to a multiple of 8 instead (2.17 → 1920x880), since the 48 grid leaves the picture 2.2 % off a 2.17 screen and
-    // the present would crop. The layout height stays 2/3 of the output height, rounded. State +0x48 u32 output height, +0x4c u32 layout height, +0x50 its float; 0 = 16:9
-    const char *as = getenv("DM_SCREEN_ASPECT");
-    if (as && *as && strcmp(as, "0") && strcmp(as, "auto")) {   // 0: 16:9; auto: the iOS front end resolves it to the screen's shape (a Mac window has none)
-        char *end; float a = strtof(as, &end);
-        if (end == as || *end || !(a >= 1.3f && a < 2.4f)) LOG("[RED] DM_SCREEN_ASPECT=%s: a width / height from 1.3 to 2.4; keeping 16:9", as);
-        else {
