     (0x45f918, '2cc79152', 'ac1b8c52', 'fitter aspect constant: mov w12,#0x8e39 (16/9 low) → mov w12,#0x60dd (2.162 low, the picture ratio 1920/888)'),
     (0x45f91c, '6cfca772', '4c01a872', 'fitter aspect constant: movk w12,#0x3fe3,lsl#16 (16/9 high) → movk w12,#0x400a,lsl#16 (2.162 high)'),
+    (0x45f978, '29c79152', 'a91b8c52', 'fitter aspect constant (2nd object): mov w9,#0x8e39 (16/9 low) → mov w9,#0x60dd (2.162 low)'),
+    (0x45f97c, '69fca772', '4901a872', 'fitter aspect constant (2nd object): movk w9,#0x3fe3,lsl#16 (16/9 high) → movk w9,#0x400a,lsl#16 (2.162 high)'),
+    # (a blanket horizontal-centering cut was reverted: it broke UI/world map; the battle-only width/rect fix is in hle_pillarbox.c)
   ],
 }
 
@@ -69,7 +72,7 @@ CUTS = {
 # 16:9 clamp. So four more observe the fitter's outputs (rect path A and B, the null-rect float clamp C) and the caller's consumption of the result at [x21+0xd0] (FIT_S)
 OBS = {
   'ace351a145c07a51f8e239666640a0d8': [
-    (0x46f2b0, 27, 'f9400102', "pillarbox: the letterbox fitter main+0x45f7d0's one non-null-rect call (bl main+0x46f2b4): x0-x5 and the 16 bytes at [x5], the input rect"),
+    (0x46f2b0, 27, 'f9400102', "pillarbox: the ldr x2,[x8] right before the letterbox fitter main+0x45f7d0's one non-null-rect call (bl main+0x46f2b4): x0-x5, the input rect at [x5] and the second rect at [x6]; x2 is read from [x8] by the callback (it runs before the ldr), and the fitter's widths are read through a child chain (hle_pillarbox.c)"),
     (0x45f988, 28, '1e230101', "pillarbox: the fitter's compare/select block, s0-s5 (the content pair converted and the clamped output pair with its offsets) and the integer pair w8/w11"),
     (0x8ed18, 29, 'd503201f', "pillarbox: the wide-viewport branch after the cuts above, w23/w24/w25 (the target triple) and s0-s3 (the converted pair, the clamp constant, the product)"),
     (0xdc5dc, 30, 'd29ae149', 'pillarbox: before the camera aspect store (str s0,[x20,#0xcd8] at +8): the camera x20, the aspect stored before, and the first-layer chain [x19+0x4d00]+0x30'),
